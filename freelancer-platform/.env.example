# ====================================================================
# Freelancer Platform - Environment Variables Template
# Copy this file to .env or configure in your deployment hosting service.
# DO NOT commit real secrets or credentials to Git.
# ====================================================================

# Port for Spring Boot backend (defaults to 8080)
PORT=8080

# Production Database Credentials (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/freelancer_platform?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_database_password

# JPA / Hibernate Evolution
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# JWT Security Configuration (REQUIRED in production: 256-bit+ secure secret)
JWT_SECRET=your_secure_256bit_production_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# ====================================================================
# Email Security Notification Configuration (SMTP)
# ====================================================================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=noreply@freelancerplatform.com
